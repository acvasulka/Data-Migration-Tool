REACT_APP_SUPABASE_URL=your_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=your_supabase_publishable_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Server-only (never exposed to the browser) ---
# Used by /api/fmx and /api/fmx-credentials to decrypt FMX creds and look
# up project rows via the service-role key.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 32-byte AES-256-GCM master key for encrypting FMX API credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FMX_CRED_KEY=your_base64_encoded_32_byte_key
